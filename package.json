{
  "name": "beneath-the-pine",
  "version": "0.1.0",
  "private": true,
  "description": "A gentle Vietnamese web companion for moving from overwhelm to one small next action.",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "pnpm --filter @beneath-the-pine/web dev",
    "dev:api": "pnpm --filter @beneath-the-pine/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @beneath-the-pine/api db:generate",
    "db:migrate": "pnpm --filter @beneath-the-pine/api db:migrate",
    "db:seed": "pnpm --filter @beneath-the-pine/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
