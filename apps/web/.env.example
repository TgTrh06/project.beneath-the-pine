# Leave empty for same-origin /api/v1. Vite proxies it to 127.0.0.1:8081.
# If set, use a full API base URL ending in /api/v1, such as
# http://127.0.0.1:8081/api/v1, and set API_WEB_ORIGIN to the web page origin.
# Production hosting must forward /api/v1 to Core API.
VITE_API_URL=
# Leave empty when Socket.IO is served from the same origin (including the Vite proxy).
# If set, use the API origin without /api/v1, such as http://127.0.0.1:8081.
VITE_REALTIME_URL=
# Local/preview demo only. The API provider must also be configured.
VITE_ASSISTANCE_DEMO=false
