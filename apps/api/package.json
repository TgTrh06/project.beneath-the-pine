{
  "name": "@beneath-the-pine/api",
  "version": "0.1.0",
  "private": true,
  "description": "Review scaffold for the manual-first modular Core API.",
  "scripts": {
    "db:migrate": "node scripts/migrate.cjs",
    "db:seed": "pnpm build && node scripts/seed.cjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.tooling.json --noEmit && node scripts/check-boundaries.cjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
