{
  "name": "@beneath-the-pine/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "job:purge": "tsx src/jobs/purge-expired-content.ts"
  },
  "dependencies": {
    "@beneath-the-pine/contracts": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "fastify": "^5.2.1",
    "openai": "^5.8.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.0.9"
  }
}
