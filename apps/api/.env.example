# Optional local file: copy to apps/api/.env. Root .env is NOT loaded by this API.
API_HOST=127.0.0.1
API_PORT=8081
API_WEB_ORIGIN=http://127.0.0.1:5173
API_LOG_LEVEL=info
# Required for account, Camp, Pact and session flows. With no database URL,
# liveness is UP but readiness returns 503. The URL below is local-only.
# Review migrations before applying them to a new development database.
# API_DATABASE_URL=postgresql://pyneath_local:pyneath_local_password@127.0.0.1:5433/pyneath_review
API_DB_POOL_MAX=5
API_DB_TIMEOUT_MS=3000
# MVP Assistance: opt in with openrouter in local/preview after setting its key.
# Keep the key server-side. Never put it in VITE_* or commit a real value.
API_ASSISTANCE_PROVIDER=disabled
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OPENROUTER_API_KEY=
# OpenRouter: one call/suggestion, 512 output tokens, 12s timeout, no app retries.
# Routing requires JSON-schema support, denies provider data collection, and caps
# input/output prices at $0.20/$0.60 per million tokens. No model substitution.
## Local inference is opt-in. Use a reviewed model and an internal origin.
# API_LOCAL_AI_URL=http://127.0.0.1:8011
# API_LOCAL_AI_TOKEN=replace-with-at-least-24-random-characters
# API_LOCAL_AI_MODEL=pyneath-assistance-vi-v2-reviewed
OPENAI_MODEL=gpt-6-luna
# OPENAI_API_KEY=

