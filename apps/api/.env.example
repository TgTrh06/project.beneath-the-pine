# Optional local file: copy to apps/api/.env. Root .env is NOT loaded by this API.
API_HOST=127.0.0.1
API_PORT=8081
API_WEB_ORIGIN=http://localhost:5173
API_LOG_LEVEL=info
# Leave unset to boot the review scaffold without connecting to PostgreSQL.
# With no database URL, liveness is UP and readiness returns 503.
# `pnpm db:local:up` exposes the local PostgreSQL container on port 5433.
# API_DATABASE_URL=postgresql://btp_local:btp_local_password@127.0.0.1:5433/btp_review
API_DB_POOL_MAX=5
API_DB_TIMEOUT_MS=3000
