# Reference only. Vite reads apps/web/.env, and the API reads apps/api/.env.
# For local development, leave the web origins empty to use Vite's API and Socket.IO proxies.
# VITE_API_URL=http://127.0.0.1:8081/api/v1
# VITE_REALTIME_URL=http://127.0.0.1:8081

# Server-only API configuration lives in apps/api/.env.example.

# Optional Compose overrides for an existing local installation. Use its actual
# inspected project, volume and PostgreSQL credentials; branding does not rename stored data.
# PYNEATH_COMPOSE_PROJECT=
# PYNEATH_POSTGRES_VOLUME=
# PYNEATH_POSTGRES_DB=
# PYNEATH_POSTGRES_USER=
# PYNEATH_POSTGRES_PASSWORD=
