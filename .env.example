# Local application URLs
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/v1

# Browser-side Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Java core service. Never commit real credentials.
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:54322/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URI=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
LOG_LEVEL=INFO
